<aside
    class="dashboard-sidebar"
    id="dashboardSidebar"
>

    <nav class="sidebar-navigation">

        <% if (user.role === "CUSTOMER") { %>

            <div class="sidebar-section">

                <span class="sidebar-section-title">
                    Main
                </span>

                <a
                    href="/dashboard"
                    class="sidebar-link <%= activePage === 'overview' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">⌂</span>
                    <span>Overview</span>
                </a>

                <a
                    href="/orders"
                    class="sidebar-link <%= activePage === 'orders' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">▣</span>
                    <span>My Orders</span>
                </a>

                <a
                    href="/wishlist"
                    class="sidebar-link <%= activePage === 'wishlist' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">♡</span>
                    <span>Wishlist</span>
                </a>

            </div>


            <div class="sidebar-section">

                <span class="sidebar-section-title">
                    Discover
                </span>

                <a
                    href="/artisans"
                    class="sidebar-link"
                >
                    <span class="sidebar-icon">♙</span>
                    <span>Artisans</span>
                </a>

                <a
                    href="/products"
                    class="sidebar-link"
                >
                    <span class="sidebar-icon">◫</span>
                    <span>Products</span>
                </a>

            </div>


            <div class="sidebar-section">

                <span class="sidebar-section-title">
                    Account
                </span>

                <a
                    href="/profile"
                    class="sidebar-link <%= activePage === 'profile' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">●</span>
                    <span>Profile</span>
                </a>

                <a
                    href="/settings"
                    class="sidebar-link <%= activePage === 'settings' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">⚙</span>
                    <span>Settings</span>
                </a>

            </div>


        <% } else if (user.role === "ARTISAN") { %>

            <div class="sidebar-section">

                <span class="sidebar-section-title">
                    Store
                </span>

                <a
                    href="/dashboard"
                    class="sidebar-link <%= activePage === 'overview' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">⌂</span>
                    <span>Overview</span>
                </a>

                <a
                    href="/artisan/products"
                    class="sidebar-link <%= activePage === 'products' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">◫</span>
                    <span>Products</span>
                </a>

                <a
                    href="/artisan/orders"
                    class="sidebar-link <%= activePage === 'orders' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">▣</span>
                    <span>Orders</span>
                </a>

            </div>


            <div class="sidebar-section">

                <span class="sidebar-section-title">
                    Business
                </span>

                <a
                    href="/artisan/earnings"
                    class="sidebar-link <%= activePage === 'earnings' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">₹</span>
                    <span>Earnings</span>
                </a>

                <a
                    href="/artisan/customers"
                    class="sidebar-link <%= activePage === 'customers' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">●</span>
                    <span>Customers</span>
                </a>

                <a
                    href="/artisan/store"
                    class="sidebar-link <%= activePage === 'store' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">◇</span>
                    <span>My Store</span>
                </a>

            </div>


            <div class="sidebar-section">

                <span class="sidebar-section-title">
                    Account
                </span>

                <a
                    href="/profile"
                    class="sidebar-link <%= activePage === 'profile' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">●</span>
                    <span>Profile</span>
                </a>

                <a
                    href="/settings"
                    class="sidebar-link <%= activePage === 'settings' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">⚙</span>
                    <span>Settings</span>
                </a>

            </div>


        <% } else if (user.role === "ADMIN") { %>

            <div class="sidebar-section">

                <span class="sidebar-section-title">
                    Platform
                </span>

                <a
                    href="/dashboard"
                    class="sidebar-link <%= activePage === 'overview' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">⌂</span>
                    <span>Overview</span>
                </a>

                <a
                    href="/admin/users"
                    class="sidebar-link <%= activePage === 'users' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">●</span>
                    <span>Users</span>
                </a>

                <a
                    href="/admin/artisans"
                    class="sidebar-link <%= activePage === 'artisans' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">♙</span>
                    <span>Artisans</span>
                </a>

                <a
                    href="/admin/products"
                    class="sidebar-link <%= activePage === 'products' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">◫</span>
                    <span>Products</span>
                </a>

                <a
                    href="/admin/orders"
                    class="sidebar-link <%= activePage === 'orders' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">▣</span>
                    <span>Orders</span>
                </a>

            </div>


            <div class="sidebar-section">

                <span class="sidebar-section-title">
                    Management
                </span>

                <a
                    href="/admin/categories"
                    class="sidebar-link <%= activePage === 'categories' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">◇</span>
                    <span>Categories</span>
                </a>

                <a
                    href="/admin/reports"
                    class="sidebar-link <%= activePage === 'reports' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">▤</span>
                    <span>Reports</span>
                </a>

                <a
                    href="/admin/settings"
                    class="sidebar-link <%= activePage === 'settings' ? 'active' : '' %>"
                >
                    <span class="sidebar-icon">⚙</span>
                    <span>Settings</span>
                </a>

            </div>

        <% } %>

    </nav>


    <div class="sidebar-bottom">

        <form
            method="POST"
            action="/auth/logout"
        >

            <button
                type="submit"
                class="logout-button"
            >
                <span class="sidebar-icon">↪</span>
                <span>Logout</span>
            </button>

        </form>

    </div>

</aside>