<%- include('../../partials/htmlHead.ejs', {pageCss: "/styles/dashboard.css"}) %>

<body class="dashboard-body">

    <%- include("../../partials/topBar.ejs") %>

    <div class="dashboard-layout">

        <%- include("../partials/sidebar", {
            activePage: "overview"
        }) %>


        <main class="dashboard-main">

            <div class="dashboard-content">

                <section class="page-header">

                    <div>

                        <p class="page-eyebrow">
                            CUSTOMER DASHBOARD
                        </p>

                        <h1>
                            Welcome back, <%= user.username %>
                        </h1>

                        <p class="page-description">
                            Here's what's happening with your orders.
                        </p>

                    </div>

                    <a
                        href="/products"
                        class="primary-button"
                    >
                        Explore products
                    </a>

                </section>


                <!-- Statistics -->

                <section class="stats-grid">

                    <div class="stat-card">

                        <div class="stat-card-header">
                            <span>Active orders</span>
                            <span class="stat-icon">▣</span>
                        </div>

                        <strong class="stat-value">
                            <%= stats?.activeOrders || 0 %>
                        </strong>

                        <span class="stat-description">
                            Currently in progress
                        </span>

                    </div>


                    <div class="stat-card">

                        <div class="stat-card-header">
                            <span>Completed</span>
                            <span class="stat-icon">✓</span>
                        </div>

                        <strong class="stat-value">
                            <%= stats?.completedOrders || 0 %>
                        </strong>

                        <span class="stat-description">
                            Orders completed
                        </span>

                    </div>


                    <div class="stat-card">

                        <div class="stat-card-header">
                            <span>Wishlist</span>
                            <span class="stat-icon">♡</span>
                        </div>

                        <strong class="stat-value">
                            <%= stats?.wishlistCount || 0 %>
                        </strong>

                        <span class="stat-description">
                            Saved products
                        </span>

                    </div>

                </section>


                <!-- Recent orders -->

                <section class="dashboard-section">

                    <div class="section-header">

                        <div>
                            <h2>
                                Recent orders
                            </h2>

                            <p>
                                Your latest purchases
                            </p>
                        </div>

                        <a
                            href="/orders"
                            class="section-link"
                        >
                            View all
                        </a>

                    </div>


                    <div class="dashboard-card">

                        <% if (orders && orders.length > 0) { %>

                            <div class="orders-table-wrapper">

                                <table class="orders-table">

                                    <thead>

                                        <tr>
                                            <th>Order</th>
                                            <th>Product</th>
                                            <th>Artisan</th>
                                            <th>Status</th>
                                            <th>Amount</th>
                                        </tr>

                                    </thead>


                                    <tbody>

                                        <% orders.forEach(order => { %>

                                            <tr>

                                                <td>
                                                    #<%= order.id %>
                                                </td>

                                                <td>
                                                    <%= order.product_name %>
                                                </td>

                                                <td>
                                                    <%= order.artisan_name %>
                                                </td>

                                                <td>

                                                    <span
                                                        class="status-badge status-<%= order.status.toLowerCase() %>"
                                                    >
                                                        <%= order.status %>
                                                    </span>

                                                </td>

                                                <td>
                                                    ₹<%= order.total %>
                                                </td>

                                            </tr>

                                        <% }) %>

                                    </tbody>

                                </table>

                            </div>

                        <% } else { %>

                            <div class="empty-state">

                                <div class="empty-state-icon">
                                    ▣
                                </div>

                                <h3>
                                    No orders yet
                                </h3>

                                <p>
                                    Discover something handmade and
                                    make your first purchase.
                                </p>

                                <a
                                    href="/products"
                                    class="primary-button"
                                >
                                    Browse products
                                </a>

                            </div>

                        <% } %>

                    </div>

                </section>


                <!-- Recommended products -->

                <section class="dashboard-section">

                    <div class="section-header">

                        <div>
                            <h2>
                                Discover something special
                            </h2>

                            <p>
                                Handmade products from our artisans
                            </p>
                        </div>

                        <a
                            href="/products"
                            class="section-link"
                        >
                            Browse all
                        </a>

                    </div>


                    <div class="product-grid">

                        <% if (products && products.length > 0) { %>

                            <% products.forEach(product => { %>

                                <a
                                    href="/products/<%= product.id %>"
                                    class="product-card"
                                >

                                    <div class="product-image">

                                        <% if (product.image_url) { %>

                                            <img
                                                src="<%= product.image_url %>"
                                                alt="<%= product.name %>"
                                            >

                                        <% } else { %>

                                            <span>
                                                No image
                                            </span>

                                        <% } %>

                                    </div>


                                    <div class="product-details">

                                        <h3>
                                            <%= product.name %>
                                        </h3>

                                        <p class="product-artisan">
                                            by <%= product.artisan_name %>
                                        </p>

                                        <strong class="product-price">
                                            ₹<%= product.price %>
                                        </strong>

                                    </div>

                                </a>

                            <% }) %>

                        <% } else { %>

                            <div class="dashboard-card empty-products">

                                <p>
                                    Products will appear here once
                                    artisans start listing their work.
                                </p>

                            </div>

                        <% } %>

                    </div>

                </section>

            </div>

        </main>

    </div>


    <%- include("../partials/footer") %>