<%- include('../../partials/htmlHead.ejs', {pageCss: "/styles/dashboard.css"}) %>

<body class="dashboard-body">

    <%- include("../../partials/topBar.ejs") %>

    <div class="dashboard-layout">

        <%- include("../partials/sidebar", {
            activePage: "overview"
        }) %>


        <main class="dashboard-main">

            <div class="dashboard-content">

                <!-- Page header -->

                <section class="page-header">

                    <div>

                        <p class="page-eyebrow">
                            ADMINISTRATION
                        </p>

                        <h1>
                            Platform overview
                        </h1>

                        <p class="page-description">
                            Monitor and manage the KalaDigital marketplace.
                        </p>

                    </div>

                </section>


                <!-- Platform statistics -->

                <section class="stats-grid admin-stats">

                    <div class="stat-card">

                        <div class="stat-card-header">
                            <span>Total users</span>
                            <span class="stat-icon">●</span>
                        </div>

                        <strong class="stat-value">
                            <%= stats?.users || 0 %>
                        </strong>

                        <span class="stat-description">
                            Registered users
                        </span>

                    </div>


                    <div class="stat-card">

                        <div class="stat-card-header">
                            <span>Artisans</span>
                            <span class="stat-icon">♙</span>
                        </div>

                        <strong class="stat-value">
                            <%= stats?.artisans || 0 %>
                        </strong>

                        <span class="stat-description">
                            Active artisans
                        </span>

                    </div>


                    <div class="stat-card">

                        <div class="stat-card-header">
                            <span>Products</span>
                            <span class="stat-icon">◫</span>
                        </div>

                        <strong class="stat-value">
                            <%= stats?.products || 0 %>
                        </strong>

                        <span class="stat-description">
                            Listed products
                        </span>

                    </div>


                    <div class="stat-card">

                        <div class="stat-card-header">
                            <span>Orders</span>
                            <span class="stat-icon">▣</span>
                        </div>

                        <strong class="stat-value">
                            <%= stats?.orders || 0 %>
                        </strong>

                        <span class="stat-description">
                            Total orders
                        </span>

                    </div>

                </section>


                <!-- Management actions -->

                <section class="dashboard-section">

                    <div class="section-header">

                        <div>
                            <h2>
                                Requires attention
                            </h2>

                            <p>
                                Items that may need administrative action
                            </p>
                        </div>

                    </div>


                    <div class="admin-actions">

                        <a
                            href="/admin/artisans?status=PENDING"
                            class="admin-action-card"
                        >

                            <span class="admin-action-number">
                                <%= stats?.pendingArtisans || 0 %>
                            </span>

                            <div>

                                <strong>
                                    Pending artisans
                                </strong>

                                <span>
                                    Review artisan applications
                                </span>

                            </div>

                        </a>


                        <a
                            href="/admin/products?status=PENDING"
                            class="admin-action-card"
                        >

                            <span class="admin-action-number">
                                <%= stats?.pendingProducts || 0 %>
                            </span>

                            <div>

                                <strong>
                                    Products to review
                                </strong>

                                <span>
                                    Review newly submitted products
                                </span>

                            </div>

                        </a>


                        <a
                            href="/admin/products?status=REPORTED"
                            class="admin-action-card"
                        >

                            <span class="admin-action-number">
                                <%= stats?.reportedProducts || 0 %>
                            </span>

                            <div>

                                <strong>
                                    Reported products
                                </strong>

                                <span>
                                    Investigate reported listings
                                </span>

                            </div>

                        </a>

                    </div>

                </section>


                <!-- Platform overview -->

                <section class="dashboard-section">

                    <div class="admin-overview-grid">

                        <div class="dashboard-card admin-panel">

                            <div class="panel-header">

                                <div>
                                    <h2>
                                        Platform activity
                                    </h2>

                                    <p>
                                        Recent marketplace activity
                                    </p>
                                </div>

                            </div>


                            <div class="activity-list">

                                <% if (activity && activity.length > 0) { %>

                                    <% activity.forEach(item => { %>

                                        <div class="activity-item">

                                            <div class="activity-icon">
                                                <%= item.icon || "•" %>
                                            </div>

                                            <div class="activity-content">

                                                <strong>
                                                    <%= item.message %>
                                                </strong>

                                                <span>
                                                    <%= item.time %>
                                                </span>

                                            </div>

                                        </div>

                                    <% }) %>

                                <% } else { %>

                                    <div class="empty-panel">
                                        No recent activity.
                                    </div>

                                <% } %>

                            </div>

                        </div>


                        <div class="dashboard-card admin-panel">

                            <div class="panel-header">

                                <div>
                                    <h2>
                                        Quick management
                                    </h2>

                                    <p>
                                        Frequently used tools
                                    </p>
                                </div>

                            </div>


                            <div class="admin-links">

                                <a href="/admin/users">
                                    <span>●</span>
                                    Manage users
                                </a>

                                <a href="/admin/artisans">
                                    <span>♙</span>
                                    Manage artisans
                                </a>

                                <a href="/admin/products">
                                    <span>◫</span>
                                    Manage products
                                </a>

                                <a href="/admin/orders">
                                    <span>▣</span>
                                    Manage orders
                                </a>

                                <a href="/admin/categories">
                                    <span>◇</span>
                                    Manage categories
                                </a>

                                <a href="/admin/reports">
                                    <span>▤</span>
                                    View reports
                                </a>

                            </div>

                        </div>

                    </div>

                </section>


                <!-- Recent orders -->

                <section class="dashboard-section">

                    <div class="section-header">

                        <div>
                            <h2>
                                Recent orders
                            </h2>

                            <p>
                                Latest marketplace transactions
                            </p>
                        </div>

                        <a
                            href="/admin/orders"
                            class="section-link"
                        >
                            View all
                        </a>

                    </div>


                    <div class="dashboard-card">

                        <% if (orders && orders.length > 0) { %>

                            <div class="orders-table-wrapper">

                                <table class="orders-table">

                                    <thead>

                                        <tr>
                                            <th>Order</th>
                                            <th>Customer</th>
                                            <th>Artisan</th>
                                            <th>Status</th>
                                            <th>Amount</th>
                                        </tr>

                                    </thead>


                                    <tbody>

                                        <% orders.forEach(order => { %>

                                            <tr>

                                                <td>
                                                    #<%= order.id %>
                                                </td>

                                                <td>
                                                    <%= order.customer_name %>
                                                </td>

                                                <td>
                                                    <%= order.artisan_name %>
                                                </td>

                                                <td>

                                                    <span class="status-badge">
                                                        <%= order.status %>
                                                    </span>

                                                </td>

                                                <td>
                                                    ₹<%= order.total %>
                                                </td>

                                            </tr>

                                        <% }) %>

                                    </tbody>

                                </table>

                            </div>

                        <% } else { %>

                            <div class="empty-state">

                                <div class="empty-state-icon">
                                    ▣
                                </div>

                                <h3>
                                    No orders yet
                                </h3>

                                <p>
                                    Marketplace orders will appear here.
                                </p>

                            </div>

                        <% } %>

                    </div>

                </section>

            </div>

        </main>

    </div>


    <%- include("../partials/footer") %>