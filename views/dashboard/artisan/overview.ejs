<%- include('../../partials/htmlHead.ejs', {pageCss: "/styles/dashboard.css"}) %>

<body class="dashboard-body">

    <%- include("../../partials/topBar.ejs") %>

    <div class="dashboard-layout">

        <%- include("../partials/sidebar", {
            activePage: "overview"
        }) %>


        <main class="dashboard-main">

            <div class="dashboard-content">

                <!-- Page header -->

                <section class="page-header">

                    <div>

                        <p class="page-eyebrow">
                            ARTISAN DASHBOARD
                        </p>

                        <h1>
                            Welcome back, <%= user.username %>
                        </h1>

                        <p class="page-description">
                            Here's how your store is doing.
                        </p>

                    </div>

                    <a
                        href="/artisan/products/new"
                        class="primary-button"
                    >
                        + Add product
                    </a>

                </section>


                <!-- Statistics -->

                <section class="stats-grid artisan-stats">

                    <div class="stat-card">

                        <div class="stat-card-header">
                            <span>Orders</span>
                            <span class="stat-icon">▣</span>
                        </div>

                        <strong class="stat-value">
                            <%= stats?.orders || 0 %>
                        </strong>

                        <span class="stat-description">
                            Orders this month
                        </span>

                    </div>


                    <div class="stat-card">

                        <div class="stat-card-header">
                            <span>Revenue</span>
                            <span class="stat-icon">₹</span>
                        </div>

                        <strong class="stat-value">
                            ₹<%= stats?.revenue || 0 %>
                        </strong>

                        <span class="stat-description">
                            This month
                        </span>

                    </div>


                    <div class="stat-card">

                        <div class="stat-card-header">
                            <span>Products</span>
                            <span class="stat-icon">◫</span>
                        </div>

                        <strong class="stat-value">
                            <%= stats?.products || 0 %>
                        </strong>

                        <span class="stat-description">
                            Active listings
                        </span>

                    </div>


                    <div class="stat-card">

                        <div class="stat-card-header">
                            <span>Customers</span>
                            <span class="stat-icon">●</span>
                        </div>

                        <strong class="stat-value">
                            <%= stats?.customers || 0 %>
                        </strong>

                        <span class="stat-description">
                            Total customers
                        </span>

                    </div>

                </section>


                <!-- Quick actions -->

                <section class="dashboard-section">

                    <div class="section-header">

                        <div>
                            <h2>
                                Quick actions
                            </h2>

                            <p>
                                Manage your store
                            </p>
                        </div>

                    </div>


                    <div class="quick-actions">

                        <a
                            href="/artisan/products/new"
                            class="action-card"
                        >

                            <span class="action-icon">
                                +
                            </span>

                            <div>
                                <strong>
                                    Add product
                                </strong>

                                <span>
                                    List a new handmade product
                                </span>
                            </div>

                        </a>


                        <a
                            href="/artisan/orders"
                            class="action-card"
                        >

                            <span class="action-icon">
                                ▣
                            </span>

                            <div>
                                <strong>
                                    View orders
                                </strong>

                                <span>
                                    Manage incoming orders
                                </span>
                            </div>

                        </a>


                        <a
                            href="/artisan/store"
                            class="action-card"
                        >

                            <span class="action-icon">
                                ◇
                            </span>

                            <div>
                                <strong>
                                    Edit store
                                </strong>

                                <span>
                                    Update your artisan profile
                                </span>
                            </div>

                        </a>

                    </div>

                </section>


                <!-- Recent orders -->

                <section class="dashboard-section">

                    <div class="section-header">

                        <div>
                            <h2>
                                Recent orders
                            </h2>

                            <p>
                                Orders requiring your attention
                            </p>
                        </div>

                        <a
                            href="/artisan/orders"
                            class="section-link"
                        >
                            View all
                        </a>

                    </div>


                    <div class="dashboard-card">

                        <% if (orders && orders.length > 0) { %>

                            <div class="orders-table-wrapper">

                                <table class="orders-table">

                                    <thead>

                                        <tr>
                                            <th>Order</th>
                                            <th>Customer</th>
                                            <th>Product</th>
                                            <th>Status</th>
                                            <th>Amount</th>
                                        </tr>

                                    </thead>


                                    <tbody>

                                        <% orders.forEach(order => { %>

                                            <tr>

                                                <td>
                                                    #<%= order.id %>
                                                </td>

                                                <td>
                                                    <%= order.customer_name %>
                                                </td>

                                                <td>
                                                    <%= order.product_name %>
                                                </td>

                                                <td>

                                                    <span class="status-badge">
                                                        <%= order.status %>
                                                    </span>

                                                </td>

                                                <td>
                                                    ₹<%= order.total %>
                                                </td>

                                            </tr>

                                        <% }) %>

                                    </tbody>

                                </table>

                            </div>

                        <% } else { %>

                            <div class="empty-state">

                                <div class="empty-state-icon">
                                    ▣
                                </div>

                                <h3>
                                    No orders yet
                                </h3>

                                <p>
                                    Orders from customers will appear here.
                                </p>

                            </div>

                        <% } %>

                    </div>

                </section>


                <!-- Products -->

                <section class="dashboard-section">

                    <div class="section-header">

                        <div>
                            <h2>
                                Your products
                            </h2>

                            <p>
                                Recently added products
                            </p>
                        </div>

                        <a
                            href="/artisan/products"
                            class="section-link"
                        >
                            Manage products
                        </a>

                    </div>


                    <div class="product-grid">

                        <% if (products && products.length > 0) { %>

                            <% products.forEach(product => { %>

                                <a
                                    href="/artisan/products/<%= product.id %>/edit"
                                    class="product-card"
                                >

                                    <div class="product-image">

                                        <% if (product.image_url) { %>

                                            <img
                                                src="<%= product.image_url %>"
                                                alt="<%= product.name %>"
                                            >

                                        <% } else { %>

                                            <span>
                                                No image
                                            </span>

                                        <% } %>

                                    </div>


                                    <div class="product-details">

                                        <h3>
                                            <%= product.name %>
                                        </h3>

                                        <p class="product-artisan">
                                            <%= product.category || "Uncategorized" %>
                                        </p>

                                        <strong class="product-price">
                                            ₹<%= product.price %>
                                        </strong>

                                    </div>

                                </a>

                            <% }) %>

                        <% } else { %>

                            <div class="dashboard-card empty-products">

                                <div class="empty-state">

                                    <div class="empty-state-icon">
                                        ◫
                                    </div>

                                    <h3>
                                        No products yet
                                    </h3>

                                    <p>
                                        Add your first product to start
                                        selling on KalaDigital.
                                    </p>

                                    <a
                                        href="/artisan/products/new"
                                        class="primary-button"
                                    >
                                        Add product
                                    </a>

                                </div>

                            </div>

                        <% } %>

                    </div>

                </section>

            </div>

        </main>

    </div>


    <%- include("../partials/footer") %>