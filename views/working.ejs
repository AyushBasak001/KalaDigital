<%- include('partials/htmlHead.ejs', {pageCss: "/styles/working.css"}) %>

<body id="top">

    <div class="top-bar">
        <%- include('partials/topBar.ejs') %>
    </div>

    <main>

        <!-- ================= HERO ================= -->
        <section class="how-hero">

            <div class="container">

                <span class="eyebrow">
                    HOW KALADIGITAL WORKS
                </span>

                <h1>
                    From traditional craft
                    <span>to trusted product.</span>
                </h1>

                <p>
                    KalaDigital connects artisans, customers and
                    administrators through a moderated marketplace where
                    product information and provenance can be documented.
                </p>

            </div>

        </section>


        <!-- ================= ROLES ================= -->
        <section class="roles-section">

            <div class="container">

                <div class="section-heading">

                    <span class="eyebrow">
                        THREE ROLES
                    </span>

                    <h2>
                        Everyone has a
                        <span>part to play.</span>
                    </h2>

                    <p>
                        KalaDigital separates marketplace responsibilities
                        between artisans, customers and administrators.
                    </p>

                </div>


                <div class="roles-grid">

                    <article class="role-card">

                        <span class="role-icon">◎</span>
                        <span class="role-number">01</span>

                        <h3>Customer</h3>

                        <p>
                            Discovers products, learns about their makers
                            and places orders.
                        </p>

                        <ul>
                            <li>Browse crafts</li>
                            <li>View artisan profiles</li>
                            <li>Inspect product information</li>
                            <li>Place orders</li>
                        </ul>

                    </article>


                    <article class="role-card featured">

                        <span class="role-icon">✦</span>
                        <span class="role-number">02</span>

                        <h3>Artisan</h3>

                        <p>
                            Creates a digital identity and documents
                            handcrafted products.
                        </p>

                        <ul>
                            <li>Create artisan profile</li>
                            <li>List products</li>
                            <li>Document craft process</li>
                            <li>Provide origin information</li>
                        </ul>

                    </article>


                    <article class="role-card">

                        <span class="role-icon">◇</span>
                        <span class="role-number">03</span>

                        <h3>Administrator</h3>

                        <p>
                            Moderates the platform and reviews submitted
                            information.
                        </p>

                        <ul>
                            <li>Verify artisans</li>
                            <li>Review products</li>
                            <li>Manage orders</li>
                            <li>Handle flagged listings</li>
                        </ul>

                    </article>

                </div>

            </div>

        </section>


        <!-- ================= WORKFLOW ================= -->
        <section class="workflow-section">

            <div class="container">

                <div class="section-heading">

                    <span class="eyebrow">
                        PRODUCT JOURNEY
                    </span>

                    <h2>
                        From artisan
                        <span>to customer.</span>
                    </h2>

                    <p>
                        A product moves through several stages before
                        reaching the customer.
                    </p>

                </div>


                <div class="workflow">

                    <div class="workflow-step">
                        <div class="workflow-number">01</div>

                        <div>
                            <span class="workflow-role">ARTISAN</span>
                            <h3>Create an artisan profile</h3>
                            <p>
                                The artisan establishes a digital identity
                                describing their craft, experience and
                                traditional practices.
                            </p>
                        </div>
                    </div>


                    <div class="workflow-step">
                        <div class="workflow-number">02</div>

                        <div>
                            <span class="workflow-role">ARTISAN</span>
                            <h3>Register a product</h3>
                            <p>
                                The artisan adds a product listing with
                                photographs, description, category and
                                other relevant information.
                            </p>
                        </div>
                    </div>


                    <div class="workflow-step">
                        <div class="workflow-number">03</div>

                        <div>
                            <span class="workflow-role">TRACEABILITY</span>
                            <h3>Document its provenance</h3>
                            <p>
                                Information about the artisan, origin,
                                materials and traditional production
                                process is associated with the product.
                            </p>
                        </div>
                    </div>


                    <div class="workflow-step admin-step">
                        <div class="workflow-number">04</div>

                        <div>
                            <span class="workflow-role">ADMIN</span>
                            <h3>Review and approve</h3>
                            <p>
                                The administrator reviews submitted
                                information before the product is made
                                available to customers.
                            </p>
                        </div>
                    </div>


                    <div class="workflow-step">
                        <div class="workflow-number">05</div>

                        <div>
                            <span class="workflow-role">CUSTOMER</span>
                            <h3>Discover the product</h3>
                            <p>
                                Customers can browse the product and
                                understand the story and information
                                associated with it.
                            </p>
                        </div>
                    </div>


                    <div class="workflow-step">
                        <div class="workflow-number">06</div>

                        <div>
                            <span class="workflow-role">CUSTOMER</span>
                            <h3>Place an order</h3>
                            <p>
                                The customer can purchase an available
                                product and manage the resulting order.
                            </p>
                        </div>
                    </div>

                </div>

            </div>

        </section>


        <!-- ================= PROVENANCE ================= -->
        <section class="provenance-section">

            <div class="container provenance-grid">

                <div class="provenance-content">

                    <span class="eyebrow">
                        PRODUCT PROVENANCE
                    </span>

                    <h2>
                        Provenance belongs
                        <span>to the product.</span>
                    </h2>

                    <p>
                        KalaDigital does not treat provenance as a separate
                        marketplace category. Instead, provenance is attached
                        to each product and provides context about its origin
                        and creation.
                    </p>

                    <p>
                        When a customer opens a product, they can inspect
                        the information available about its maker, origin,
                        materials and craft process.
                    </p>

                </div>


                <div class="provenance-card">

                    <div class="provenance-header">
                        <span>PRODUCT RECORD</span>
                        <strong>Provenance</strong>
                    </div>


                    <div class="provenance-item">
                        <span class="provenance-icon">♙</span>

                        <div>
                            <small>ARTISAN</small>
                            <strong>Who made it?</strong>
                        </div>
                    </div>


                    <div class="provenance-item">
                        <span class="provenance-icon">◎</span>

                        <div>
                            <small>ORIGIN</small>
                            <strong>Where did it come from?</strong>
                        </div>
                    </div>


                    <div class="provenance-item">
                        <span class="provenance-icon">◇</span>

                        <div>
                            <small>MATERIALS</small>
                            <strong>What was used?</strong>
                        </div>
                    </div>


                    <div class="provenance-item">
                        <span class="provenance-icon">✦</span>

                        <div>
                            <small>PROCESS</small>
                            <strong>How was it made?</strong>
                        </div>
                    </div>

                </div>

            </div>

        </section>


        <!-- ================= AUTHENTICITY ================= -->
        <section class="authenticity-section">

            <div class="container">

                <div class="section-heading">

                    <span class="eyebrow">
                        SUPPORTING AUTHENTICITY
                    </span>

                    <h2>
                        Transparency helps
                        <span>build trust.</span>
                    </h2>

                    <p>
                        KalaDigital combines structured information with
                        administrative moderation to reduce misleading
                        representation.
                    </p>

                </div>


                <div class="authenticity-grid">

                    <div class="auth-item">
                        <span>01</span>

                        <h3>Artisan Verification</h3>

                        <p>
                            Artisan accounts can be reviewed before their
                            products are represented on the platform.
                        </p>
                    </div>


                    <div class="auth-item">
                        <span>02</span>

                        <h3>Product Documentation</h3>

                        <p>
                            Product listings contain structured information
                            about their origin, maker and creation.
                        </p>
                    </div>


                    <div class="auth-item">
                        <span>03</span>

                        <h3>Administrative Review</h3>

                        <p>
                            Administrators can review listings and respond
                            to suspicious or misleading representations.
                        </p>
                    </div>

                </div>

            </div>

        </section>


        <!-- ================= CTA ================= -->
        <section class="how-cta">

            <div class="container">

                <span class="eyebrow">
                    READY TO EXPLORE?
                </span>

                <h2>
                    Discover the story behind
                    <span>the craft.</span>
                </h2>

                <p>
                    Browse handcrafted products and discover the artisans
                    and traditions behind them.
                </p>

                <a href="/products" class="btn btn-light">
                    Explore Crafts →
                </a>

            </div>

        </section>

    </main>


    <div class="footer">
        <%- include('partials/footer.ejs') %>
    </div>

</body>
</html>