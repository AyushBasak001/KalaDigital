<%- include('partials/htmlHead.ejs', {pageCss: "/styles/artisan.css"}) %>

<body>

    <div class="top-bar">
        <%- include('partials/topBar.ejs') %>
    </div>

    <main>

        <!-- ================= HERO ================= -->

        <section class="artisans-hero">

            <div class="container">

                <span class="eyebrow">
                    THE PEOPLE BEHIND THE CRAFT
                </span>

                <h1>
                    Meet the
                    <span>artisans.</span>
                </h1>

                <p>
                    Discover the people who preserve traditional skills,
                    techniques and craft traditions through their work.
                </p>

            </div>

        </section>


        <% if (featuredArtisan) { %>

            <!-- ================= FEATURED ARTISAN ================= -->

            <section class="featured-artisan">

                <div class="container featured-artisan-grid">

                    <div class="featured-artisan-image">

                        <% if (featuredArtisan.profile_image) { %>

                            <img
                                src="<%= featuredArtisan.profile_image %>"
                                alt="<%= featuredArtisan.display_name %>"
                            >

                        <% } else { %>

                            <span>FEATURED ARTISAN</span>

                        <% } %>

                    </div>


                    <div class="featured-artisan-content">

                        <span class="eyebrow">
                            ARTISAN SPOTLIGHT
                        </span>

                        <h2>
                            The hands behind
                            <span>the tradition.</span>
                        </h2>

                        <div class="artisan-display_name">
                            <%= featuredArtisan.display_name %>
                        </div>

                        <p>
                            <%= featuredArtisan.bio %>
                        </p>


                        <div class="artisan-stats">

                            <div>
                                <strong>
                                    <%= featuredArtisan.years_of_experience %>+
                                </strong>
                                <small>Years of Craft</small>
                            </div>

                            <div>
                                <strong>
                                    <%= featuredArtisan.craft_speciality %>
                                </strong>
                                <small>Craft</small>
                            </div>

                            <% if (featuredArtisan.verification_status === 'VERIFIED') { %>
                                <div>
                                    <strong>✓</strong>
                                    <small>Verified</small>
                                </div>
                            <% } %>

                        </div>


                        <a
                            href="/artisans/<%= featuredArtisan.id %>"
                            class="btn btn-primary"
                        >
                            View Artisan Profile →
                        </a>

                    </div>

                </div>

            </section>

        <% } %>


        <!-- ================= DIRECTORY ================= -->

        <section class="artisan-directory">

            <div class="container">

                <div class="directory-heading">

                    <div>
                        <span class="eyebrow">
                            ARTISAN DIRECTORY
                        </span>

                        <h2>
                            Discover the
                            <span>makers.</span>
                        </h2>
                    </div>


                    <div class="artisan-search">

                        <input
                            type="search"
                            placeholder="Search artisans..."
                        >

                        <button>
                            Search
                        </button>

                    </div>

                </div>


                <div class="artisan-grid">

                    <% artisanList.forEach(artisan => { %>

                        <article class="artisan-card">

                            <a href="/artisans/<%= artisan.id %>"
                            class="artisan-card-image">

                                <img
                                    src="<%= artisan.profile_image %>"
                                    alt="<%= artisan.display_name %>"
                                >

                                <% if (artisan.verification_status === 'VERIFIED') { %>
                                    <div class="verified-mark">
                                        ✓
                                    </div>
                                <% } %>

                            </a>

                            <div class="artisan-card-content">

                                <span class="artisan-craft">
                                    <%= artisan.craft_speciality %>
                                </span>

                                <h3>
                                    <%= artisan.display_name %>
                                </h3>

                                <div class="artisan-place">
                                    <%= artisan.location %>, <%= artisan.state %>
                                </div>

                                <p>
                                    <%= artisan.bio %>
                                </p>

                                <div class="artisan-card-footer">

                                    <span>
                                        <%= artisan.years_of_experience %> Years Experience
                                    </span>

                                    <a href="/artisans/<%= artisan.id %>">
                                        Profile →
                                    </a>

                                </div>

                            </div>

                        </article>

                    <% }) %>

                </div>

            </div>

        </section>


        <!-- ================= WHY ARTISANS ================= -->

        <section class="artisan-purpose">

            <div class="container">

                <div class="artisan-purpose-grid">

                    <div>

                        <span class="eyebrow">
                            WHY ARTISAN PROFILES MATTER
                        </span>

                        <h2>
                            A product is more meaningful
                            when you know
                            <span>who made it.</span>
                        </h2>

                    </div>


                    <div class="purpose-list">

                        <div>
                            <span>01</span>

                            <div>
                                <h3>Identity</h3>

                                <p>
                                    Give traditional artisans a digital
                                    presence and recognizable identity.
                                </p>
                            </div>
                        </div>


                        <div>
                            <span>02</span>

                            <div>
                                <h3>Context</h3>

                                <p>
                                    Connect products with the people and
                                    traditions behind their creation.
                                </p>
                            </div>
                        </div>


                        <div>
                            <span>03</span>

                            <div>
                                <h3>Trust</h3>

                                <p>
                                    Structured profiles help customers
                                    understand who they are buying from.
                                </p>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </section>

    </main>


    <div class="footer">
        <%- include('partials/footer.ejs') %>
    </div>

</body>
</html>