<%- include('partials/htmlHead.ejs', {pageCss: "/styles/artisan.css"}) %>

<body>

    <div class="top-bar">
        <%- include('partials/topBar.ejs') %>
    </div>

    <main>

        <!-- ================= HERO ================= -->

        <section class="artisans-hero">

            <div class="container">

                <span class="eyebrow">
                    THE PEOPLE BEHIND THE CRAFT
                </span>

                <h1>
                    Meet the
                    <span>artisans.</span>
                </h1>

                <p>
                    Discover the people who preserve traditional skills,
                    techniques and craft traditions through their work.
                </p>

            </div>

        </section>


        <!-- ================= FEATURED ARTISAN ================= -->

        <section class="featured-artisan">

            <div class="container featured-artisan-grid">

                <div class="featured-artisan-image">
                    <span>FEATURED ARTISAN</span>
                </div>


                <div class="featured-artisan-content">

                    <span class="eyebrow">
                        ARTISAN SPOTLIGHT
                    </span>

                    <h2>
                        The hands behind
                        <span>the tradition.</span>
                    </h2>

                    <div class="artisan-location">
                        Bastar, Chhattisgarh
                    </div>

                    <p>
                        Discover the work of artisans who continue
                        traditional craft practices and bring them
                        to a wider audience through KalaDigital.
                    </p>

                    <div class="artisan-stats">

                        <div>
                            <strong>12+</strong>
                            <small>Products</small>
                        </div>

                        <div>
                            <strong>15</strong>
                            <small>Years of Craft</small>
                        </div>

                        <div>
                            <strong>1</strong>
                            <small>Tradition</small>
                        </div>

                    </div>

                    <a href="/artisans/1"
                       class="btn btn-primary">
                        View Artisan Profile →
                    </a>

                </div>

            </div>

        </section>


        <!-- ================= DIRECTORY ================= -->

        <section class="artisan-directory">

            <div class="container">

                <div class="directory-heading">

                    <div>
                        <span class="eyebrow">
                            ARTISAN DIRECTORY
                        </span>

                        <h2>
                            Discover the
                            <span>makers.</span>
                        </h2>
                    </div>


                    <div class="artisan-search">

                        <input
                            type="search"
                            placeholder="Search artisans..."
                        >

                        <button>
                            Search
                        </button>

                    </div>

                </div>


                <div class="artisan-grid">


                    <!-- ARTISAN 1 -->

                    <article class="artisan-card">

                        <a href="/artisans/1"
                           class="artisan-card-image">

                            <span>ARTISAN</span>

                            <div class="verified-mark">
                                ✓
                            </div>

                        </a>

                        <div class="artisan-card-content">

                            <span class="artisan-craft">
                                WOODCRAFT
                            </span>

                            <h3>
                                Artisan Name
                            </h3>

                            <div class="artisan-place">
                                Bastar, Chhattisgarh
                            </div>

                            <p>
                                Traditional woodcraft and hand carving.
                            </p>

                            <div class="artisan-card-footer">

                                <span>
                                    8 Products
                                </span>

                                <a href="/artisans/1">
                                    Profile →
                                </a>

                            </div>

                        </div>

                    </article>


                    <!-- ARTISAN 2 -->

                    <article class="artisan-card">

                        <a href="/artisans/2"
                           class="artisan-card-image artisan-two">

                            <span>ARTISAN</span>

                            <div class="verified-mark">
                                ✓
                            </div>

                        </a>

                        <div class="artisan-card-content">

                            <span class="artisan-craft">
                                TEXTILES
                            </span>

                            <h3>
                                Artisan Name
                            </h3>

                            <div class="artisan-place">
                                Chanderi, Madhya Pradesh
                            </div>

                            <p>
                                Traditional handloom weaving.
                            </p>

                            <div class="artisan-card-footer">

                                <span>
                                    14 Products
                                </span>

                                <a href="/artisans/2">
                                    Profile →
                                </a>

                            </div>

                        </div>

                    </article>


                    <!-- ARTISAN 3 -->

                    <article class="artisan-card">

                        <a href="/artisans/3"
                           class="artisan-card-image artisan-three">

                            <span>ARTISAN</span>

                            <div class="verified-mark">
                                ✓
                            </div>

                        </a>

                        <div class="artisan-card-content">

                            <span class="artisan-craft">
                                POTTERY
                            </span>

                            <h3>
                                Artisan Name
                            </h3>

                            <div class="artisan-place">
                                Raipur, Chhattisgarh
                            </div>

                            <p>
                                Traditional clay and terracotta craft.
                            </p>

                            <div class="artisan-card-footer">

                                <span>
                                    6 Products
                                </span>

                                <a href="/artisans/3">
                                    Profile →
                                </a>

                            </div>

                        </div>

                    </article>


                    <!-- ARTISAN 4 -->

                    <article class="artisan-card">

                        <a href="/artisans/4"
                           class="artisan-card-image artisan-four">

                            <span>ARTISAN</span>

                            <div class="verified-mark">
                                ✓
                            </div>

                        </a>

                        <div class="artisan-card-content">

                            <span class="artisan-craft">
                                METALCRAFT
                            </span>

                            <h3>
                                Artisan Name
                            </h3>

                            <div class="artisan-place">
                                Kondagaon, Chhattisgarh
                            </div>

                            <p>
                                Traditional metalworking and sculpture.
                            </p>

                            <div class="artisan-card-footer">

                                <span>
                                    11 Products
                                </span>

                                <a href="/artisans/4">
                                    Profile →
                                </a>

                            </div>

                        </div>

                    </article>


                    <!-- ARTISAN 5 -->

                    <article class="artisan-card">

                        <a href="/artisans/5"
                           class="artisan-card-image artisan-five">

                            <span>ARTISAN</span>

                            <div class="verified-mark">
                                ✓
                            </div>

                        </a>

                        <div class="artisan-card-content">

                            <span class="artisan-craft">
                                JEWELLERY
                            </span>

                            <h3>
                                Artisan Name
                            </h3>

                            <div class="artisan-place">
                                Odisha
                            </div>

                            <p>
                                Traditional handcrafted jewellery.
                            </p>

                            <div class="artisan-card-footer">

                                <span>
                                    9 Products
                                </span>

                                <a href="/artisans/5">
                                    Profile →
                                </a>

                            </div>

                        </div>

                    </article>


                    <!-- ARTISAN 6 -->

                    <article class="artisan-card">

                        <a href="/artisans/6"
                           class="artisan-card-image artisan-six">

                            <span>ARTISAN</span>

                            <div class="verified-mark">
                                ✓
                            </div>

                        </a>

                        <div class="artisan-card-content">

                            <span class="artisan-craft">
                                TEXTILES
                            </span>

                            <h3>
                                Artisan Name
                            </h3>

                            <div class="artisan-place">
                                Rajasthan
                            </div>

                            <p>
                                Traditional textile and weaving practices.
                            </p>

                            <div class="artisan-card-footer">

                                <span>
                                    7 Products
                                </span>

                                <a href="/artisans/6">
                                    Profile →
                                </a>

                            </div>

                        </div>

                    </article>

                </div>

            </div>

        </section>


        <!-- ================= WHY ARTISANS ================= -->

        <section class="artisan-purpose">

            <div class="container">

                <div class="artisan-purpose-grid">

                    <div>

                        <span class="eyebrow">
                            WHY ARTISAN PROFILES MATTER
                        </span>

                        <h2>
                            A product is more meaningful
                            when you know
                            <span>who made it.</span>
                        </h2>

                    </div>


                    <div class="purpose-list">

                        <div>
                            <span>01</span>

                            <div>
                                <h3>Identity</h3>

                                <p>
                                    Give traditional artisans a digital
                                    presence and recognizable identity.
                                </p>
                            </div>
                        </div>


                        <div>
                            <span>02</span>

                            <div>
                                <h3>Context</h3>

                                <p>
                                    Connect products with the people and
                                    traditions behind their creation.
                                </p>
                            </div>
                        </div>


                        <div>
                            <span>03</span>

                            <div>
                                <h3>Trust</h3>

                                <p>
                                    Structured profiles help customers
                                    understand who they are buying from.
                                </p>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </section>

    </main>


    <div class="footer">
        <%- include('partials/footer.ejs') %>
    </div>

</body>
</html>