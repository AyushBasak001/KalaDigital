<header class="site-header">

    <div class="nav-container">

        <a href="/" class="brand">
            <span class="brand-mark">K</span>

            <span class="brand-text">
                <strong>KalaDigital</strong>
                <small>CRAFT • CULTURE • CONNECTION</small>
            </span>
        </a>


        <nav class="main-nav">

            <a href="/" class="nav-link active">
                Home
            </a>

            <a href="/products" class="nav-link">
                Explore Crafts
            </a>

            <a href="/artisans" class="nav-link">
                Meet Artisans
            </a>

            <a href="/working" class="nav-link">
                How it Works
            </a>

        </nav>


        <div class="nav-actions">
            <% if (locals.user) { %>
                <form action="/auth/logout" method="POST">
                    <button class="nav-logout" type="submit">Logout</button>
                </form>

                <a href="/" class="nav-cta">
                    <%= locals.user.username %>
                </a>

            <% } else { %>
            <a href="/auth" class="nav-login">
                Login
            </a>

            <a href="/auth" class="nav-cta">
                Enter KalaDigital
                <span>→</span>
            </a>
            <% } %>

        </div>


        <button class="mobile-menu" aria-label="Open menu">
            <span></span>
            <span></span>
            <span></span>
        </button>

    </div>

</header>